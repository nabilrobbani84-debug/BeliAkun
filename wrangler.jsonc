{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beliakun",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "beliakun.com", "custom_domain": true },
    { "pattern": "www.beliakun.com", "custom_domain": true }
  ]
}
